<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pioneer.medgo.dao.NoticeDAO">
<resultMap id="NoticeResultMap" type="com.pioneer.medgo.dto.NoticeDTO">
    <id property="noticeid" column="ID"/>
    <result property="title" column="TITLE"/>
    <result property="content" column="CONTENT"/>
    <result property="createdat" column="CREATED_AT"/>
    <result property="pharmacyid" column="PHARMACY_ID"/>
</resultMap>
  <select id="getNoticesByPharmacyId" resultType="NoticeDTO" parameterType="int">
        SELECT * FROM PHARMACY_BOARD WHERE pharmacy_id = #{pharmacyid} ORDER BY id DESC
    </select>

    <select id="getNoticeByNoticeId" resultType="NoticeDTO" parameterType="int">
        SELECT * FROM PHARMACY_BOARD WHERE noticeid = #{noticeid}
    </select>

    <insert id="insertNotice" parameterType="NoticeDTO" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO PHARMACY_BOARD (pharmacy_id, title, content)
        VALUES (#{pharmacyid}, #{title}, #{content})
    </insert>

    <update id="updateNotice" parameterType="NoticeDTO">
        UPDATE PHARMACY_BOARD
        SET title = #{title}, content = #{content}
        WHERE noticeid = #{noticeid}
    </update>
    <delete id="deleteNotice" parameterType="int">
        DELETE FROM PHARMACY_BOARD WHERE noticeid = #{noticeid}
    </delete>

</mapper>