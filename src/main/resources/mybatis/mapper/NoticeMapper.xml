<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pioneer.medgo.dao.NoticeDAO">
<resultMap id="NoticeResultMap" type="com.pioneer.medgo.dto.NoticeDTO">
    <id property="noticeid" column="ID"/>
    <result property="title" column="TITLE"/>
    <result property="content" column="CONTENT"/>
    <result property="createdat" column="CREATED_AT"/>
    <result property="pharmacyid" column="PHARMACY_ID"/>
</resultMap>
      <!-- 공지사항 페이징 조회 -->
  <select id="getNoticesByPharmacyId" resultType="NoticeDTO">
    <![CDATA[
    SELECT * FROM (
        SELECT n.*, ROWNUM rnum
        FROM (
            SELECT * 
            FROM PHARMACY_BOARD
            WHERE PHARMACY_ID = #{pharmacyid}
            ORDER BY CREATED_AT DESC
        ) n
        WHERE ROWNUM <= #{end}
    )
    WHERE rnum > #{start}
    ]]>
  </select>
  
  	 <!-- 전체 공지사항 개수 -->
	 <select id="getNoticeCount" resultType="int">
	   SELECT COUNT(*) 
	   FROM PHARMACY_BOARD 
	   WHERE PHARMACY_ID = #{pharmacyid}
	 </select>


    <select id="getNoticeByNoticeId" resultMap="NoticeResultMap" parameterType="int">
        SELECT * FROM PHARMACY_BOARD WHERE ID = #{noticeid}
    </select>

    <insert id="insertNotice" parameterType="NoticeDTO" useGeneratedKeys="true" keyProperty="noticeid" keyColumn="ID">
        INSERT INTO PHARMACY_BOARD (pharmacy_id, title, content)
        VALUES (#{pharmacyid}, #{title}, #{content})
    </insert>

    <update id="updateNotice" parameterType="NoticeDTO">
        UPDATE PHARMACY_BOARD
        SET title = #{title}, content = #{content}
        WHERE ID = #{noticeid}
    </update>
    <delete id="deleteNotice" parameterType="int">
        DELETE FROM PHARMACY_BOARD WHERE ID = #{noticeid}
    </delete>

</mapper>