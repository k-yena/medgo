<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pioneer.medgo.dao.LoginDAO">
	<select id="findByEmail"
		resultType="com.pioneer.medgo.domain.LoginDTO" parameterType="String">
		select *
		from member where email = #{email}
	</select>
	<select id="countByUser" parameterType="String"
		resultType="int">
		select count(*) from member WHERE email = #{email}
	</select>
	<insert id="insert"
		parameterType="com.pioneer.medgo.domain.LoginDTO">
		<selectKey resultType="int" keyProperty="id" order="BEFORE">
			select
			member_seq.nextval from dual
		</selectKey>
		insert into member (id, email, password) values (#{id}, #{email}, #{password})
	</insert>
	<delete id="delete" parameterType="int">
		delete from member where id = #{id}
	</delete>
	<update id="update"
		parameterType="com.pioneer.medgo.domain.LoginDTO">
		update member set
		email = #{email},
		password = #{password}
		where id = #{id}
	</update>
</mapper> 